{
  "name": "@hortinis/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "fix": "pnpm run lint:fix && pnpm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "dexie": "^4.4.7",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "angular-eslint": "22.1.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.12"
  }
}
