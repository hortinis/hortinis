{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "FullAuthenticationStatus.json",
    "type": "object",
    "properties": {
        "state": {
            "type": "string",
            "const": "authenticated"
        },
        "accountId": {
            "$ref": "AccountId.json"
        }
    },
    "required": [
        "state",
        "accountId"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}