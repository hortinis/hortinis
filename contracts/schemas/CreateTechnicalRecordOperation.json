{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "CreateTechnicalRecordOperation.json",
    "type": "object",
    "properties": {
        "operationId": {
            "$ref": "UuidV7.json",
            "description": "The stable operation and idempotency identifier."
        },
        "recordId": {
            "$ref": "UuidV7.json"
        },
        "value": {
            "type": "string"
        },
        "kind": {
            "type": "string",
            "const": "create"
        }
    },
    "required": [
        "operationId",
        "recordId",
        "value",
        "kind"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Create a technical record that does not yet exist."
}