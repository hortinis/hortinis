{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ReplaceTechnicalRecordOperation.json",
    "type": "object",
    "properties": {
        "protocolVersion": {
            "type": "number",
            "const": 1,
            "description": "The version of the persisted synchronization envelope."
        },
        "operationId": {
            "$ref": "UuidV7.json",
            "description": "The stable operation and idempotency identifier."
        },
        "recordId": {
            "$ref": "UuidV7.json"
        },
        "value": {
            "type": "string"
        },
        "kind": {
            "type": "string",
            "const": "replace"
        },
        "expectedRevision": {
            "$ref": "PositiveDecimal.json"
        }
    },
    "required": [
        "protocolVersion",
        "operationId",
        "recordId",
        "value",
        "kind",
        "expectedRevision"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Replace a technical record at its expected server revision."
}