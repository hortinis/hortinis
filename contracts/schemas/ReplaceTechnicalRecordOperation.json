{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ReplaceTechnicalRecordOperation.json",
    "type": "object",
    "properties": {
        "operationId": {
            "$ref": "Uuid.json",
            "description": "The stable operation and idempotency identifier."
        },
        "recordId": {
            "$ref": "Uuid.json"
        },
        "value": {
            "type": "string"
        },
        "kind": {
            "type": "string",
            "const": "replace"
        },
        "expectedRevision": {
            "$ref": "PositiveDecimal.json"
        }
    },
    "required": [
        "operationId",
        "recordId",
        "value",
        "kind",
        "expectedRevision"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Replace a technical record at its expected server revision."
}