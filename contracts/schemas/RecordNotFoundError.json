{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "RecordNotFoundError.json",
    "type": "object",
    "properties": {
        "code": {
            "type": "string",
            "const": "RECORD_NOT_FOUND"
        },
        "message": {
            "type": "string",
            "minLength": 1
        },
        "operationId": {
            "$ref": "Uuid.json"
        },
        "recordId": {
            "$ref": "Uuid.json"
        }
    },
    "required": [
        "code",
        "message",
        "operationId",
        "recordId"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "The operation targets a technical record that does not exist."
}