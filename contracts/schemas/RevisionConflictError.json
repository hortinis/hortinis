{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "RevisionConflictError.json",
    "type": "object",
    "properties": {
        "code": {
            "type": "string",
            "const": "REVISION_CONFLICT"
        },
        "message": {
            "type": "string",
            "minLength": 1
        },
        "operationId": {
            "$ref": "Uuid.json"
        },
        "expectedRevision": {
            "$ref": "PositiveDecimal.json"
        },
        "currentRecord": {
            "$ref": "TechnicalRecord.json"
        }
    },
    "required": [
        "code",
        "message",
        "operationId",
        "expectedRevision",
        "currentRecord"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Replacement failed because the expected and current revisions differ."
}