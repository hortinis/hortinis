{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "CredentialSummary.json",
    "type": "object",
    "properties": {
        "id": {
            "$ref": "WebAuthnCredentialId.json"
        },
        "label": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[^\\u0000]*$",
            "description": "Optional user label; Unicode scalar text excluding NUL."
        }
    },
    "required": [
        "id"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}