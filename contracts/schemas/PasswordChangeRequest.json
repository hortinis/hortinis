{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "PasswordChangeRequest.json",
    "type": "object",
    "properties": {
        "currentPassword": {
            "$ref": "LoginPassword.json"
        },
        "newPassword": {
            "$ref": "NewPassword.json"
        }
