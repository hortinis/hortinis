{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "RecoveryCodeSet.json",
    "type": "object",
    "properties": {
        "codes": {
            "type": "array",
            "items": {
                "$ref": "EncodedRandomValue.json"
            },
            "minItems": 10,
            "maxItems": 10,
            "uniqueItems": true
        },
        "expiresAt": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "codes",
        "expiresAt"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}