{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "AvailableRecoveryCodeStatus.json",
    "type": "object",
    "properties": {
        "remaining": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
        },
        "expiresAt": {
            "type": "string",
            "format": "date-time"
        },
        "expiresSoon": {
            "type": "boolean"
        }
    },
    "required": [
        "remaining",
        "expiresAt",
        "expiresSoon"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}