{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "WebAuthnAlgorithm.json",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "public-key"
        },
        "alg": {
            "anyOf": [
                {
                    "type": "number",
                    "const": -7
                },
                {
                    "type": "number",
                    "const": -257
                },
                {
                    "type": "number",
                    "const": -8
                }
            ]
        }
    },
    "required": [
        "type",
        "alg"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}