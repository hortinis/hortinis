{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "WebAuthnUser.json",
    "type": "object",
    "properties": {
        "id": {
            "$ref": "EncodedRandomValue.json"
        },
        "name": {
            "$ref": "LoginIdentifier.json"
        },
        "displayName": {
            "type": "string",
            "const": "Hortinis account"
        }
    },
    "required": [
        "id",
        "name",
        "displayName"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}